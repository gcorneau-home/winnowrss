<Window x:Class="Winnow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Winnow.App.ViewModels"
        xmlns:loc="clr-namespace:Winnow.App.Localization"
        xmlns:views="clr-namespace:Winnow.App.Views"
        xmlns:controls="clr-namespace:Winnow.App.Controls"
        xmlns:services="clr-namespace:Winnow.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="WinnowRSS" Width="1300" Height="820" Icon="/Assets/winnow.ico"
        Background="{DynamicResource Winnow.WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseSelectedTabCommand}" />
        <KeyBinding Gesture="Ctrl+F4" Command="{Binding CloseSelectedTabCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                Background="{DynamicResource Winnow.HeaderBackground}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0"
                        Content="&#xE713;" FontFamily="{StaticResource IconFont}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="{loc:Tr Toolbar_Settings_Tip}"
                        AutomationProperties.AutomationId="Settings"
                        AutomationProperties.Name="{loc:Tr Toolbar_Settings_Tip}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                        Content="&#xE790;" FontFamily="{StaticResource IconFont}" Command="{Binding OpenThemesCommand}"
                        ToolTip="{loc:Tr Toolbar_Themes_Tip}"
                        AutomationProperties.AutomationId="ManageThemes"
                        AutomationProperties.Name="{loc:Tr Toolbar_Themes_Tip}" />
                <ComboBox DockPanel.Dock="Right" MinWidth="150" Margin="0,0,4,0"
                          ItemsSource="{Binding Themes, Source={x:Static services:ThemeService.Instance}}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding ThemeCode}"
                          ToolTip="{loc:Tr Toolbar_Theme_Tip}"
                          AutomationProperties.AutomationId="Theme"
                          AutomationProperties.Name="{loc:Tr Toolbar_Theme_Tip}" />
                <!-- Language names are shown in their own language, so they are not translated. -->
                <ComboBox DockPanel.Dock="Right" MinWidth="120"
                          ItemsSource="{x:Static loc:Localizer.Languages}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding LanguageCode}"
                          ToolTip="{loc:Tr Toolbar_Language_Tip}"
                          AutomationProperties.AutomationId="Language"
                          AutomationProperties.Name="{loc:Tr Toolbar_Language_Tip}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                    <Grid Width="280">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="GlobalSearch"
                                 AutomationProperties.Name="{loc:Tr Toolbar_Search_Placeholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{loc:Tr Toolbar_Search_Placeholder}" IsHitTestVisible="False"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                                   Visibility="{Binding SearchText.Length, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                    <Button Style="{StaticResource ToolButton}" Margin="4,0,0,0" Command="{Binding SearchCommand}"
                            Content="&#xE721;" FontFamily="{StaticResource IconFont}"
                            ToolTip="{loc:Tr Toolbar_Search_Tip}"
                            AutomationProperties.AutomationId="SearchButton"
                            AutomationProperties.Name="{loc:Tr Toolbar_Search_Tip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddCategoryCommand}"
                            ToolTip="{loc:Tr Toolbar_Category_Tip}"
                            AutomationProperties.AutomationId="AddCategory"
                            AutomationProperties.Name="{loc:Tr Toolbar_Category_Tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" />
                            <TextBlock Text="{loc:Tr Toolbar_Category}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddFeedCommand}"
                            ToolTip="{loc:Tr Toolbar_Feed_Tip}"
                            AutomationProperties.AutomationId="AddFeed"
                            AutomationProperties.Name="{loc:Tr Toolbar_Feed_Tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                            <TextBlock Text="{loc:Tr Toolbar_Feed}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshAllCommand}"
                            ToolTip="{loc:Tr Toolbar_Refresh_Tip}"
                            AutomationProperties.AutomationId="RefreshAll"
                            AutomationProperties.Name="{loc:Tr Toolbar_Refresh_Tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                            <TextBlock Text="{loc:Tr Toolbar_Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenFilterSettingsCommand}"
                            ToolTip="{loc:Tr Toolbar_Filter_Tip}"
                            AutomationProperties.AutomationId="FilterSettings"
                            AutomationProperties.Name="{loc:Tr Toolbar_Filter_Tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" />
                            <TextBlock Text="{loc:Tr Toolbar_Filter}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding ShowRejected}" Padding="10,5"
                                  Content="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                  ToolTip="{loc:Tr Toolbar_ShowRejected_Tip}"
                                  AutomationProperties.AutomationId="ShowRejected"
                                  AutomationProperties.Name="{loc:Tr Toolbar_ShowRejected_Tip}" />
                    <ToggleButton IsChecked="{Binding ShowRead}" Padding="10,5" Margin="4,0,0,0"
                                  Content="&#xE8C3;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                  ToolTip="{loc:Tr Toolbar_ShowRead_Tip}"
                                  AutomationProperties.AutomationId="ShowRead"
                                  AutomationProperties.Name="{loc:Tr Toolbar_ShowRead_Tip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                Background="{DynamicResource Winnow.HeaderBackground}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Status}" Opacity="0.8" AutomationProperties.AutomationId="Status" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tag carries the main view model so context menus (outside the visual tree) can reach its commands. -->
            <controls:LibraryTreeView x:Name="Tree"
                      AutomationProperties.AutomationId="Library"
                      controls:LibraryTreeViewItem.Invoked="Tree_ItemInvoked"
                      ItemsSource="{Binding Roots}"
                      Tag="{Binding}"
                      BorderThickness="0"
                      Background="{DynamicResource Winnow.SurfaceBackground}"
                      AllowDrop="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                      MouseMove="Tree_MouseMove"
                      MouseDoubleClick="Tree_MouseDoubleClick"
                      PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                      KeyDown="Tree_KeyDown"
                      DragOver="Tree_DragOver"
                      Drop="Tree_Drop">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="controls:LibraryTreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AutomationStatus}" />
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal"
                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}">
                            <StackPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Tr Menu_AddFeed}" Command="{Binding AddFeedCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Tr Menu_Rename}" Command="{Binding RenameCategoryCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Menu_Delete}" Command="{Binding DeleteCategoryCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Count}" Text="{Binding UnreadCount}"
                                       Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type vm:FeedNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}"
                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}">
                            <StackPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Tr Menu_OpenUnread}" Command="{Binding OpenUnreadArticlesCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Tr Menu_Refresh}" Command="{Binding RefreshFeedCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Tr Menu_Edit}" Command="{Binding EditFeedCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Menu_Delete}" Command="{Binding DeleteFeedCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="OrangeRed"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource Count}" Text="{Binding UnreadCount}"
                                       Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type vm:ArticleNodeViewModel}">
                        <!-- TreeViewItem does not constrain header width, so cap it to the tree width minus indentation. -->
                        <DockPanel x:Name="Row" ToolTip="{Binding ToolTip}" Background="Transparent"
                                   Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                   MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource Subtract}, ConverterParameter=100}">
                            <DockPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Tr Menu_Open}" Command="{Binding OpenArticleNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Tr Menu_Archive}" Command="{Binding ArchiveArticlesCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsArchived, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InvertBoolToVisibility}}" />
                                    <MenuItem Header="{loc:Tr Menu_MoveToTrash}" Command="{Binding TrashArticlesCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsInTrash, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InvertBoolToVisibility}}" />
                                    <MenuItem Header="{loc:Tr Menu_Restore}" Command="{Binding RestoreArticlesCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsInTrash, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE718;" FontSize="12"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="11" Opacity="0.6"
                                       Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Foreground="OrangeRed"
                                       Visibility="{Binding HasFilterError, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse x:Name="UnreadDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <TextBlock x:Name="RejectedIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="11"
                                       Opacity="0.7" Visibility="Collapsed" />
                            <TextBlock x:Name="Title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <!-- Unread: bold and/or dot; read: dimmed if chosen. Filtered-out articles are never marked unread. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CountsAsUnread}" Value="True" />
                                    <Condition Binding="{Binding UnreadBold, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="FontWeight" Value="Bold" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CountsAsUnread}" Value="True" />
                                    <Condition Binding="{Binding UnreadDot, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="UnreadDot" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRead}" Value="True" />
                                    <Condition Binding="{Binding DimRead, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="Opacity" Value="0.55" />
                            </MultiDataTrigger>
                            <!-- Filtered out: still there and clickable, marked the way the user chose. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRejected}" Value="True" />
                                    <Condition Binding="{Binding RejectedDimmed, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="Opacity" Value="0.45" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRejected}" Value="True" />
                                    <Condition Binding="{Binding RejectedItalic, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRejected}" Value="True" />
                                    <Condition Binding="{Binding RejectedIcon, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RejectedIcon" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRejected}" Value="True" />
                                    <Condition Binding="{Binding RejectedStrikethrough, Source={x:Static services:DisplaySettings.Instance}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <!-- Translucent accent, readable on light and dark themes. -->
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Winnow.MultiSelectBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type vm:ArchiveNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" />
                            <TextBlock Text="{loc:Tr Node_Archive}" FontStyle="Italic" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type vm:TrashNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}">
                            <StackPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Tr Menu_EmptyTrash}" Command="{Binding EmptyTrashCommand}" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                            <TextBlock Text="{loc:Tr Node_Trash}" FontStyle="Italic" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type vm:PlaceholderNodeViewModel}">
                        <TextBlock Text="{Binding Name}" FontStyle="Italic" Opacity="0.6" />
                    </DataTemplate>
                </TreeView.Resources>
            </controls:LibraryTreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Reading area -->
            <TextBlock Grid.Column="2" Text="{loc:Tr Reading_Placeholder}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                       Visibility="{Binding Tabs.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
            <TabControl x:Name="ArticleTabs" Grid.Column="2"
                        AutomationProperties.AutomationId="ArticleTabs"
                        ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        Visibility="{Binding Tabs.Count, Converter={StaticResource CountToVisibility}}">
                <!-- A single content template for all tabs, so the article view (and its browser) is created once
                     and kept while switching between article and search tabs. -->
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <Grid>
                            <Border Visibility="{Binding IsArticle, Converter={StaticResource BoolToVisibility}}">
                                <views:ArticleView DataContext="{Binding AsArticle}" />
                            </Border>
                            <Border Visibility="{Binding IsSearch, Converter={StaticResource BoolToVisibility}}">
                                <views:SearchResultsView DataContext="{Binding AsSearch}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <!-- Docked right, the close button always stays visible; a long title is trimmed instead. -->
                        <DockPanel ToolTip="{Binding ToolTip}" MaxWidth="240" Background="Transparent"
                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                            <DockPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Tr Menu_CloseTab}" Command="{Binding CloseTabFromMenuCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Menu_CloseOtherTabs}" Command="{Binding CloseOtherTabsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Menu_CloseAllTabs}" Command="{Binding CloseAllTabsCommand}" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Content="&#xE711;"
                                    AutomationProperties.AutomationId="CloseTab"
                                    FontFamily="{StaticResource IconFont}" FontSize="10"
                                    Padding="4" Margin="8,0,0,0" MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="{loc:Tr Tab_Close_Tip}"
                                    AutomationProperties.Name="{loc:Tr Tab_Close_Tip}" />
                            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
