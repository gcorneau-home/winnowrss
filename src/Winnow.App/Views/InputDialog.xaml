<Window x:Class="Winnow.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Winnow.App.Localization"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Winnow.WindowBackground}"
        AutomationProperties.AutomationId="InputDialog">
    <StackPanel Margin="20">
        <ItemsControl x:Name="FieldList" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Tr Dialog_OK}" AutomationProperties.AutomationId="Ok" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="{loc:Tr Dialog_Cancel}" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
