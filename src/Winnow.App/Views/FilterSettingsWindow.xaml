<Window x:Class="Winnow.App.Views.FilterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Winnow.App.ViewModels"
        xmlns:loc="clr-namespace:Winnow.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FilterSettingsViewModel}"
        Title="{loc:Tr FilterWindow_Title}"
        Width="680" Height="720" MinWidth="520" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Winnow.WindowBackground}"
        AutomationProperties.AutomationId="FilterSettingsWindow">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- One editable row per criterion: enabled, text, remove. -->
        <DataTemplate x:Key="CriterionRow" DataType="{x:Type vm:CriterionRowViewModel}">
            <DockPanel Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0"
                          ToolTip="{loc:Tr Filter_CriterionEnabled_Tip}"
                          AutomationProperties.Name="{loc:Tr Filter_CriterionEnabled_Tip}" />
                <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="6,0,0,0"
                        Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Tr Filter_RemoveCriterion}"
                        AutomationProperties.Name="{loc:Tr Filter_RemoveCriterion}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text}" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="OrangeRed" TextWrapping="Wrap"
                       Visibility="{Binding ErrorText.Length, Converter={StaticResource CountToVisibility}}" />
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Tr Dialog_Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="100" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="SaveFilter" />
                    <Button Content="{loc:Tr Dialog_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="100"
                            AutomationProperties.AutomationId="CancelFilter" />
                </StackPanel>
                <CheckBox Content="{loc:Tr Filter_Refilter}" IsChecked="{Binding RefilterAfterSave}" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="RefilterAfterSave" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <CheckBox Content="{loc:Tr Filter_Enabled}" IsChecked="{Binding Enabled}"
                          AutomationProperties.AutomationId="FilterEnabled" />

                <!-- Model -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Tr Filter_Endpoint}" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Column="1" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             AutomationProperties.AutomationId="FilterEndpoint"
                             AutomationProperties.Name="{loc:Tr Filter_Endpoint}" />
                    <TextBlock Grid.Row="1" Text="{loc:Tr Filter_Model}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <DockPanel Grid.Row="1" Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Filter_TestConnection}" Command="{Binding TestConnectionCommand}"
                                Margin="8,0,0,0" AutomationProperties.AutomationId="TestConnection" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding AvailableModels}"
                                  Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.AutomationId="FilterModel"
                                  AutomationProperties.Name="{loc:Tr Filter_Model}" />
                    </DockPanel>
                </Grid>
                <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Help}" Margin="0,6,0,0"
                           AutomationProperties.AutomationId="ConnectionStatus" />

                <!-- Interests -->
                <TextBlock Text="{loc:Tr Filter_Interests}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Filter_Interests_Help}" Style="{StaticResource Help}" />
                <ItemsControl ItemsSource="{Binding Interests}" ItemTemplate="{StaticResource CriterionRow}" IsTabStop="False"
                              AutomationProperties.AutomationId="Interests" />
                <Button Content="{loc:Tr Filter_AddInterest}" Command="{Binding AddInterestCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddInterest" />

                <!-- Exclusions -->
                <TextBlock Text="{loc:Tr Filter_Exclusions}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Filter_Exclusions_Help}" Style="{StaticResource Help}" />
                <ItemsControl ItemsSource="{Binding Exclusions}" ItemTemplate="{StaticResource CriterionRow}" IsTabStop="False"
                              AutomationProperties.AutomationId="Exclusions" />
                <Button Content="{loc:Tr Filter_AddExclusion}" Command="{Binding AddExclusionCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddExclusion" />

                <!-- Keywords -->
                <TextBlock Text="{loc:Tr Filter_Keywords}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Filter_Keywords_Help}" Style="{StaticResource Help}" />
                <ItemsControl ItemsSource="{Binding Keywords}" ItemTemplate="{StaticResource CriterionRow}" IsTabStop="False"
                              AutomationProperties.AutomationId="Keywords" />
                <Button Content="{loc:Tr Filter_AddKeyword}" Command="{Binding AddKeywordCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddKeyword" />

                <!-- Trusted feeds -->
                <TextBlock Text="{loc:Tr Filter_TrustedFeeds}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{loc:Tr Filter_TrustedFeeds_Help}" Style="{StaticResource Help}" />
                <ItemsControl ItemsSource="{Binding Feeds}" IsTabStop="False" AutomationProperties.AutomationId="TrustedFeeds">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrustedFeedRowViewModel}">
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding SkipFilter}" Margin="0,0,0,4"
                                      AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
